{
  "openapi": "3.0.3",
  "info": {
    "title": "Wydarzka API",
    "version": "0.0.1",
    "description": "Placeholder spec — run `pnpm api:sync` with backend running to get the real spec."
  },
  "servers": [
    {
      "url": "{apiUrl}",
      "variables": {
        "apiUrl": {
          "default": "http://localhost:3000"
        }
      }
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/events": {
      "get": {
        "operationId": "listEvents",
        "summary": "List events with filtering",
        "parameters": [
          { "name": "lat", "in": "query", "schema": { "type": "number" } },
          { "name": "lng", "in": "query", "schema": { "type": "number" } },
          { "name": "category", "in": "query", "schema": { "type": "array", "items": { "type": "string" } } },
          { "name": "dateFrom", "in": "query", "schema": { "type": "string" } },
          { "name": "dateTo", "in": "query", "schema": { "type": "string" } },
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of events",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedEventsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/events/{id}": {
      "get": {
        "operationId": "getEvent",
        "summary": "Get event details",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Event details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventResponse"
                }
              }
            }
          },
          "404": { "description": "Event not found" }
        }
      }
    },
    "/venues": {
      "get": {
        "operationId": "listVenues",
        "summary": "List venues",
        "parameters": [
          { "name": "city", "in": "query", "schema": { "type": "string" } },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of venues",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedVenuesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/venues/{id}": {
      "get": {
        "operationId": "getVenue",
        "summary": "Get venue profile",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Venue profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VenueResponse"
                }
              }
            }
          },
          "404": { "description": "Venue not found" }
        }
      }
    },
    "/venues/{id}/events": {
      "get": {
        "operationId": "listVenueEvents",
        "summary": "List events for a venue",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Venue events",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedEventsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/cities": {
      "get": {
        "operationId": "listCities",
        "summary": "List supported cities",
        "responses": {
          "200": {
            "description": "List of cities",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CitiesResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "status": { "type": "string" }
            },
            "required": ["status"]
          }
        },
        "required": ["data"]
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "nextCursor": { "type": "string", "nullable": true },
          "hasMore": { "type": "boolean" },
          "total": { "type": "integer" }
        },
        "required": ["nextCursor", "hasMore", "total"]
      },
      "EventVenue": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "address": { "type": "string" }
        },
        "required": ["id", "name", "address"]
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": "string" },
          "category": { "type": "string" },
          "venue": { "$ref": "#/components/schemas/EventVenue" },
          "imageUrl": { "type": "string" },
          "date": { "type": "string" },
          "time": { "type": "string" },
          "startDate": { "type": "string" },
          "endDate": { "type": "string", "nullable": true },
          "priceFrom": { "type": "number" },
          "lat": { "type": "number" },
          "lng": { "type": "number" },
          "description": { "type": "string" },
          "badges": { "type": "array", "items": { "type": "string" } },
          "city": { "type": "string" },
          "eventPhotos": { "type": "array", "items": { "type": "string" } },
          "ticketUrl": { "type": "string", "nullable": true },
          "source": { "type": "string", "nullable": true },
          "scoutUsername": { "type": "string", "nullable": true }
        },
        "required": ["id", "title", "category", "venue", "imageUrl", "date", "time", "startDate", "priceFrom", "lat", "lng", "description", "badges", "city"]
      },
      "PaginatedEventsResponse": {
        "type": "object",
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Event" } },
          "meta": { "$ref": "#/components/schemas/PaginationMeta" }
        },
        "required": ["data", "meta"]
      },
      "EventResponse": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/Event" }
        },
        "required": ["data"]
      },
      "Venue": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "category": { "type": "string" },
          "address": { "type": "string" },
          "city": { "type": "string" },
          "lat": { "type": "number" },
          "lng": { "type": "number" },
          "description": { "type": "string", "nullable": true },
          "imageUrl": { "type": "string", "nullable": true },
          "phone": { "type": "string", "nullable": true },
          "website": { "type": "string", "nullable": true },
          "instagram": { "type": "string", "nullable": true },
          "facebook": { "type": "string", "nullable": true },
          "googleMapsUrl": { "type": "string", "nullable": true },
          "photos": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["id", "name", "slug", "category", "address", "city", "lat", "lng"]
      },
      "PaginatedVenuesResponse": {
        "type": "object",
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Venue" } },
          "meta": { "$ref": "#/components/schemas/PaginationMeta" }
        },
        "required": ["data", "meta"]
      },
      "VenueResponse": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/Venue" }
        },
        "required": ["data"]
      },
      "City": {
        "type": "object",
        "properties": {
          "slug": { "type": "string" },
          "name": { "type": "string" },
          "region": { "type": "string" },
          "lat": { "type": "number" },
          "lng": { "type": "number" },
          "eventCount": { "type": "integer" }
        },
        "required": ["slug", "name", "region", "lat", "lng", "eventCount"]
      },
      "CitiesResponse": {
        "type": "object",
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/City" } }
        },
        "required": ["data"]
      }
    }
  }
}
